// -----------------------------------------------------------------------------
// 2. Символьні масиви char
// -----------------------------------------------------------------------------

// char-масиви використовують для класичних C-рядків.
// Рядок має завершуватися
// спеціальним символом '\0' - термінатором.
// Тому для тексту "Hello" потрібно 6 байтів:
// 'H', 'e', 'l', 'l', 'o', '\0'.
char welcomeMessage[] = "Hello";

// Явне оголошення символів.
