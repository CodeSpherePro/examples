// Це директива умовного компілятора,
// яка перевіряє архітектуру плати і підключає
// спеціальну бібліотеку для роботи з пам'яттю лише тоді,
// коли це дійсно необхідно.Вона забезпечує кросплатформеність
// (універсальність) коду, щоб він без помилок компілювався як на старих Arduino Uno,
// так і на нових платах (наприклад, ESP32 або Arduino Due).
// для ESP32 перевірка на ARDUINO_ARCH_ESP32
#if defined(ARDUINO_ARCH_AVR)
#include <avr/pgmspace.h>
#endif

// Команда #define — це директива препроцесора,
// яка виконує текстову заміну в коді безпосередньо перед початком компіляції
// Макрос для підрахунку кількості елементів у масиві.
// sizeof(x) повертає розмір у байтах усього масиву.
// sizeof((x)[0]) повертає розмір у байтах одного елемента.
// Тому ділення дає саме кількість елементів.
//
// Важливо: цей макрос правильно працює тільки там,
// де масив справді оголошений.
// Усередині функції, куди масив передали як параметр,
// він уже перетворюється на покажчик,
// тому sizeof() більше не знає реального розміру масиву.
#define ARRAY_SIZE(x) (sizeof(x) / sizeof((x)[0]))

// -----------------------------------------------------------------------------
