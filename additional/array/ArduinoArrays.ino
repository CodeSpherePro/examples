//
// Погано для економії пам'яті Uno:
int badPins[] = {2, 3, 4, 5, 6};
// 5 елементів * 2 байти = 10 байтів.

// Краще:
byte goodPins[] = {2, 3, 4, 5, 6};
// 5 елементів * 1 байт = 5 байтів.

// -----------------------------------------------------------------------------
// 4. Масиви у Flash-пам'яті: PROGMEM
// -----------------------------------------------------------------------------

// На Arduino Uno/Nano оперативної пам'яті SRAM дуже мало -
// приблизно 2 КБ.
// Великі константні масиви, які не змінюються під час роботи,
// краще зберігати у Flash-пам'яті за допомогою PROGMEM.
//
// Приклади: таблиці символів для дисплея, іконки,
// мелодії, довідники.
const byte customChar[] PROGMEM = {
  0b00000,
  0b01010,
  0b11111,
  0b11111,
  0b01110,
  0b00100,
  0b00000
};

// Масив нот для пищалки.
// На Uno int займає 2 байти,
// тому для читання з PROGMEM використовуємо
// pgm_read_word(), а не звичайний доступ melodyTicks[i].
const int melodyTicks[] PROGMEM = {262, 294, 330, 349, 392, 440, 494};

