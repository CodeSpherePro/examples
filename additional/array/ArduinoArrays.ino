// -----------------------------------------------------------------------------
// 7. Сучасний C++: std::array
// -----------------------------------------------------------------------------

// На сучасних платах ESP8266, ESP32, Arduino Nano Every або Raspberry Pi Pico
// іноді можна використовувати std::array з C++11.
//
// #include <array>
//
// std::array<float, 4> kalmanWeights = {0.1, 0.15, 0.22, 0.35};
//
// Перевага:
// int len = kalmanWeights.size();
//
// Для Arduino Uno класичні C-масиви зазвичай простіші та прогнозованіші.

// -----------------------------------------------------------------------------
// 8. Передача масивів у функції
// -----------------------------------------------------------------------------

byte lessonPins[] = {2, 3, 4, 5, 6};
const byte LESSON_PIN_COUNT = ARRAY_SIZE(lessonPins);

int readings[] = {512, 1023, 0, 720};
int lightSensors[] = {10, 45, 90, 12, 33, 88};

// Спосіб 1. Класичний: через квадратні дужки.
// Функція приймає масив pins[] та окремо його розмір size.
// У C++ масив при передачі у функцію перетворюється на адресу першого елемента,
// тому розмір потрібно передавати окремим параметром.
void setPinsAsOutput(byte pins[], byte size) {
  for (byte i = 0; i < size; i++) {
    Serial.print("Налаштування піна №");
    Serial.println(i);
    pinMode(pins[i], OUTPUT);
  }
}

// Спосіб 2. Через покажчик.
// Запис int* array означає: array - це адреса першого int у масиві.
// Для компілятора це майже те саме, що int array[].
void printArray(const int* array, byte size) {
  for (byte i = 0; i < size; i++) {
    Serial.println(array[i]);
  }
}

// Головне правило безпеки: якщо функція тільки читає масив, додаємо const.
// Так компілятор не дозволить випадково змінити оригінальні дані.
void showData(const byte data[], byte size) {
  for (byte i = 0; i < size; i++) {
    // data[i] = 0; // Так робити не можна: const забороняє зміну.
    Serial.println(data[i]);
  }
}

// Спосіб 3. Безпечний шаблон: без ручної передачі розміру.
// T - тип елементів масиву.
// N - кількість елементів, яку компілятор визначає автоматично.
// Запис T (&array)[N] означає "посилання на справжній масив розміру N".
template <typename T, size_t N>
void printWithTemplate(const T (&array)[N]) {
  for (size_t i = 0; i < N; i++) {
    Serial.println(array[i]);
  }
}

// Приклад обчислення середнього значення.
// Тут const потрібен, бо функція лише читає дані.
float averageIntArray(const int data[], byte size) {
  long sum = 0;

  for (byte i = 0; i < size; i++) {
    sum += data[i];
  }

  return (float)sum / size;
}

// -----------------------------------------------------------------------------
// 9. Помилка початківців із sizeof() усередині функції
// -----------------------------------------------------------------------------

void explainSizeofProblem(int arr[]) {
  // Не використовуйте таку формулу для переданого масиву:
  // int wrongSize = sizeof(arr) / sizeof(arr[0]);
  //
  // Причина:
  // arr тут уже не справжній масив, а покажчик на перший елемент.
  // На Arduino Uno покажчик займає 2 байти.
  // Тому sizeof(arr) покаже розмір покажчика, а не розмір усього масиву.
  //
  // Правильно:
  // 1. Порахувати розмір там, де масив оголошено.
  // 2. Передати цей розмір у функцію окремим параметром.
  (void)arr;
}

// -----------------------------------------------------------------------------
// 10. Практичні приклади для уроку
// -----------------------------------------------------------------------------

// Приклад 1. Автоматичне налаштування пінів світлодіодів.
byte ledPins[] = {2, 3, 4, 5, 6};
const byte LED_COUNT = ARRAY_SIZE(ledPins);

// Приклад 2. Буфер для тексту з Serial.
// Масив має 10 байтів: максимум 9 символів тексту + '\0'.
char receivedData[10];
byte charCount = 0;

// Приклад 3. Мелодія у Flash-пам'яті.
const byte BUZZER_PIN = 9;
const int melody[] PROGMEM = {262, 294, 330, 349, 392, 440, 494, 523};
const byte NOTE_COUNT = ARRAY_SIZE(melody);

void setup() {
  Serial.begin(9600);

  Serial.println("Урок: масиви в Arduino C++");

  // Використання масиву для швидкого налаштування кількох пінів.
  Serial.println("Використання масиву для швидкого налаштування кількох пінів.");
  setPinsAsOutput(ledPins, LED_COUNT);
  Serial.println("Передача масиву в функцію через квадратні дужки.");
  // Передача масиву у функцію через квадратні дужки.
  showData(lessonPins, LESSON_PIN_COUNT);

  // Передача масиву у функцію через покажчик.
  Serial.println("Передача масиву в функцію через покажчик.");
  printArray(readings, ARRAY_SIZE(readings));

  // Передача масиву через шаблон без ручного size.
  Serial.println("Передача масиву через шаблон без ручного size");
  printWithTemplate(lightSensors);

  // Обчислення середнього значення.
  Serial.println("Обчислення середнього значення");
  float average = averageIntArray(readings, ARRAY_SIZE(readings));
  Serial.print("Average reading: ");
  Serial.println(average);

  // Приклад доступу до двовимірного масиву.
  Serial.print("Center key value is: ");
  Serial.println(keys[1][1]); // Рядок 1, стовпець 1 - це символ '5'.

  // Приклад читання з PROGMEM.
  // Для byte використовують pgm_read_byte().
  Serial.println("Приклад читання з PROGMEM. byte");
  byte firstIconRow = pgm_read_byte(&customChar[0]);
  Serial.print("First icon row from PROGMEM: ");
  Serial.println(firstIconRow, BIN);

  // Для int використовують pgm_read_word().
  Serial.println("Приклад читання з PROGMEM. int");
  for (byte i = 0; i < NOTE_COUNT; i++) {
    int noteHz = pgm_read_word(&melody[i]);
    Serial.print("Melody note: ");
    Serial.println(noteHz);
  }

  Serial.println("Send up to 9 characters in Serial Monitor.");
}

void loop() {
  // Приклад "біжучого вогню" для одновимірного масиву пінів.
  for (byte i = 0; i < LED_COUNT; i++) {
    digitalWrite(ledPins[i], HIGH);
    delay(100);
    digitalWrite(ledPins[i], LOW);
  }

  // Приклад накопичення символів із Serial у char-масив.
  // Якщо користувач надсилає більше 9 символів, зайві символи не записуються,
  // щоб не вийти за межі масиву.
  while (Serial.available() > 0 && charCount < ARRAY_SIZE(receivedData) - 1) {
    char newChar = Serial.read();

    if (newChar == '\n' || newChar == '\r') {
      break;
    }

    receivedData[charCount] = newChar;
    charCount++;
  }

  if (charCount > 0) {
    receivedData[charCount] = '\0'; // Обов'язково закриваємо рядок.

    Serial.print("Received string: ");
    Serial.println(receivedData);

    charCount = 0;
  }
}
